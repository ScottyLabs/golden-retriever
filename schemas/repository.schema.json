{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "repository.schema.json",
  "title": "Repository",
  "description": "Schema for a repository registration file.",
  "type": "object",
  "required": [
    "name",
    "slug"
  ],
  "anyOf": [
    {
      "required": [
        "github"
      ]
    },
    {
      "required": [
        "forgejo"
      ]
    }
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "Human-readable repository name."
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+([a-z0-9-]*[a-z0-9])?$",
      "description": "URL-safe identifier. Must match the filename (without .json)."
    },
    "description": {
      "type": "string",
      "description": "A brief description of the repository."
    },
    "github": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$",
      "description": "GitHub repository in owner/repo format (e.g. \"my-org/my-project\")."
    },
    "forgejo": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$",
      "description": "Forgejo/Codeberg repository in owner/repo format (e.g. \"my-org/my-project\")."
    }
  },
  "additionalProperties": false
}
